{% macro css(src, extra_attributes) %}
    <link rel="stylesheet" {{ extra_attributes|raw }} href="{{ asset(src) }}" {{ oro_integrity(asset(src)) }}>
{% endmacro %}

{% macro js(src) %}
    <script src="{{ asset(src) }}" {{ oro_integrity(asset(src)) }}></script>
{% endmacro %}

{% macro js_modules_config(config) %}
    <script data-role="config" type="application/json">
        {{ config|json_encode|raw }}
    </script>
{% endmacro %}
